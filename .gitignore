# --- publication exclusions -------------------------------------------------
# Kept out of the public repository deliberately, not because they are secret:
# the turn reports are an internal engineering log carrying local machine paths
# and session reasoning, and the ledger is workflow scratch. The product docs in
# docs/spec/ ARE published - they are what the README links to.
docs/turns/
.workflow/
__pycache__/
*.pyc

# The wiki assembler builds wiki/log.d shards into wiki/hot.md and wiki/log.md.
# The wiki itself is part of the internal engineering log and is not published, so
# the tool that assembles it would be dead weight here.
tools/wiki-assemble.ps1
